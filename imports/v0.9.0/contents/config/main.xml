<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0 http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
  <kcfgfile name=""/>
  <group name="General">
    <entry name="language" type="String"><default>ru</default></entry>
    <entry name="autoFit" type="Bool"><default>true</default></entry>
    <entry name="rowHeight" type="Int"><default>108</default></entry>
    <entry name="maxHeight" type="Int"><default>720</default></entry>
    <entry name="showRoot" type="Bool"><default>true</default></entry>
    <entry name="showBoot" type="Bool"><default>false</default></entry>
    <entry name="showFs" type="Bool"><default>true</default></entry>
    <entry name="showPhysical" type="Bool"><default>true</default></entry>
    <entry name="backgroundOpacity" type="Int"><default>40</default></entry>
    <entry name="textOpacity" type="Int"><default>90</default></entry>
    <entry name="rounded" type="Bool"><default>true</default></entry>
    <entry name="cornerRadius" type="Int"><default>15</default></entry>
    <entry name="edgeOpacity" type="Int"><default>100</default></entry>
    <entry name="edgeWidth" type="Int"><default>30</default></entry>
    <entry name="edgeCurve" type="Int"><default>0</default></entry>
    <entry name="outerMargin" type="Int"><default>3</default></entry>
    <entry name="contentPadding" type="Int"><default>16</default></entry>
    <entry name="contentProtection" type="Int"><default>35</default></entry>
    <entry name="discoveryInterval" type="Int"><default>10</default></entry>
    <entry name="updateInterval" type="Int"><default>60</default></entry>
    <entry name="warningPercent" type="Int"><default>80</default></entry>
    <entry name="criticalPercent" type="Int"><default>90</default></entry>
  </group>
</kcfg>
